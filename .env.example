# Sao chép thành .env rồi sửa. File .env KHÔNG được commit (đã nằm trong .gitignore).
# Khóa JWT dùng chung giữa ứng dụng và Document Server. Tạo bằng:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ONLYOFFICE_JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai

# Địa chỉ Document Server mà TRÌNH DUYỆT truy cập được
ONLYOFFICE_URL=http://localhost:8080
# Địa chỉ ứng dụng này mà DOCUMENT SERVER truy cập được (ứng dụng chạy trên máy, Document Server trong Docker)
ONLYOFFICE_APP_URL=http://host.docker.internal:4000
# (Tùy chọn) địa chỉ Document Server mà ứng dụng truy cập được, nếu khác ONLYOFFICE_URL
# ONLYOFFICE_INTERNAL_URL=http://localhost:8080
